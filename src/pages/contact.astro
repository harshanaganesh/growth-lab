---
// CONTACT PAGE. Shows your Tally form once you add tallyFormId in my-details.mjs.
import Base from '../layouts/Base.astro';
import { me } from '../../my-details.mjs';
const tally = me.tallyFormId
  ? `https://tally.so/embed/${me.tallyFormId}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`
  : '';
---
<Base title="Contact" description={`Get in touch with ${me.name} about growth marketing and analytics roles.`} crumbs={[{ name: 'Contact', path: '/contact/' }]}>
  <section class="section">
    <div class="wrap contact">
      <div class="stack">
        <p class="eyebrow">Contact</p>
        <h1>Let's talk</h1>
        <p class="lead">Hiring, a project, or a question about the research? I usually reply within a day.</p>
        <div class="card ways">
          <div><span class="eyebrow">Email</span><p><a href={`mailto:${me.email}`}>{me.email}</a></p></div>
          <div><span class="eyebrow">LinkedIn</span><p><a href={me.linkedin}>Message me on LinkedIn</a></p></div>
        </div>
      </div>
      <div class="card form-box">
        {tally ? (
          <>
            <iframe data-tally-src={tally} loading="lazy" width="100%" height="420" frameborder="0" title="Contact form"></iframe>
            <script is:inline async src="https://tally.so/widgets/embed.js"></script>
          </>
        ) : (
          <div class="placeholder">
            <p><strong>Your contact form appears here.</strong></p>
            <p class="muted">Create a free form at tally.so, then paste its ID into tallyFormId in my-details.mjs.</p>
          </div>
        )}
      </div>
    </div>
  </section>
</Base>

<style>
  .contact { display: grid; grid-template-columns: 1fr 1.1fr; gap: 48px; align-items: start; }
  .ways { display: grid; gap: 18px; margin-top: 8px; }
  .ways p { font-weight: 600; margin-top: 4px; word-break: break-word; }
  .form-box { min-height: 320px; }
  .placeholder { display: grid; gap: 8px; place-content: center; min-height: 280px; text-align: center; border: 1.5px dashed var(--line); border-radius: 10px; padding: 24px; }
  @media (max-width: 860px) { .contact { grid-template-columns: 1fr; } }
</style>
