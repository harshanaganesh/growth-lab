---
// CONTACT PAGE. Your email and links come from my-details.mjs.
import Base from '../layouts/Base.astro';
import { me } from '../../my-details.mjs';
---
<Base title="Contact" description={`Get in touch with ${me.name} about growth marketing and analytics roles.`} crumbs={[{ name: 'Contact', path: '/contact/' }]}>
  <section class="section">
    <div class="wrap contact">
      <div class="stack">
        <p class="eyebrow">Contact</p>
        <h1>Let's talk</h1>
        <p class="lead">Hiring, a project, or a question about the research? I usually reply within a day.</p>
      </div>
      <div class="card ways">
        <div><span class="eyebrow">Email</span><p><a href={`mailto:${me.email}`}>{me.email}</a></p></div>
        <div><span class="eyebrow">LinkedIn</span><p><a href={me.linkedin}>Message me on LinkedIn</a></p></div>
        <div><span class="eyebrow">GitHub</span><p><a href={me.github}>See how this site is built</a></p></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .ways { display: grid; gap: 22px; padding: 32px; }
  .ways p { font-weight: 600; margin-top: 4px; word-break: break-word; font-size: 1.1rem; }
  @media (max-width: 860px) { .contact { grid-template-columns: 1fr; } }
</style>