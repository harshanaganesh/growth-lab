---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn't exist." noindex>
  <section class="section">
    <div class="wrap stack" style="max-width: 640px;">
      <p class="eyebrow">404</p>
      <h1>This page isn't in the lab.</h1>
      <p class="lead">It may have moved. Try the research or the tools instead.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/research/">Research</a>
        <a class="btn btn-ghost" href="/tools/">Tools</a>
      </div>
    </div>
  </section>
</Base>
