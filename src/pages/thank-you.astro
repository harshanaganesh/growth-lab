---
// Shown after someone sends the contact form. GA4 counts visits here as contact_submit.
import Base from '../layouts/Base.astro';
---
<Base title="Thank you" description="Thanks for getting in touch." noindex>
  <section class="section">
    <div class="wrap stack" style="max-width: 640px; text-align: center; justify-items: center;">
      <p class="eyebrow">Message sent</p>
      <h1>Thank you!</h1>
      <p class="lead">I'll reply within a day. In the meantime, have a look at the research.</p>
      <a class="btn btn-primary" href="/research/">See the research →</a>
    </div>
  </section>
</Base>
