---
// The frame around every page: <head>, SEO tags, tracking, schema, menu and footer.
// You don't need to edit this file. Your details come from my-details.mjs.
import '../styles/global.css';
import { me } from '../../my-details.mjs';

const {
  title,
  description,
  schema = [],          // extra schema.org objects for this page
  crumbs = [],          // breadcrumb names, e.g. [{ name: 'Tools', path: '/tools/' }]
  noindex = false,
  type = 'website',
} = Astro.props;

const site = me.siteUrl.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, site + '/').href;
const fullTitle = Astro.url.pathname === '/' ? title : `${title} · ${me.name}`;
const ogImage = site + '/og.png';

const breadcrumb = crumbs.length
  ? [{
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', path: '/' }, ...crumbs].map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: site + c.path,
      })),
    }]
  : [];
const allSchema = [...schema, ...breadcrumb];

const nav = [
  { name: 'Research', path: '/research/' },
  { name: 'Tools', path: '/tools/' },
  { name: 'Case studies', path: '/case-studies/' },
  { name: 'About', path: '/about/' },
];
const here = Astro.url.pathname;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="google-site-verification" content="w-2Lq9lS52FjLL_LOhB1Vmg3gCyvWmxJzARukbdpOQ8" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#2b57f5" />

    <!-- How your page looks when shared on LinkedIn, WhatsApp, X -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={`${me.name} · Growth Lab`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Figtree:wght@400..700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet" />

    <!-- Schema markup: labels that tell Google and AI assistants what this page is -->
    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <!-- Google Analytics 4 (switches on when you add ga4Id in my-details.mjs) -->
    {me.ga4Id && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${me.ga4Id}`}></script>}
    {me.ga4Id && (
      <script is:inline define:vars={{ id: me.ga4Id }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', id);
      </script>
    )}

    <!-- Microsoft Clarity (switches on when you add clarityId) -->
    {me.clarityId && (
      <script is:inline define:vars={{ id: me.clarityId }}>
        (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window, document, "clarity", "script", id);
      </script>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap bar">
        <a class="brand" href="/">
          <span class="mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22"><path d="M4 18 L9 12 L13 15 L20 6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="20" cy="6" r="2.4" fill="currentColor"/></svg>
          </span>
          <span><strong>{me.name}</strong><span class="lab"> · Growth Lab</span></span>
        </a>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.path} aria-current={here.startsWith(n.path) ? 'page' : undefined}>{n.name}</a>
          ))}
          <a class="btn btn-primary nav-cta" href="/contact/">Contact</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot-grid">
        <div class="stack">
          <a class="brand" href="/"><strong>{me.name}</strong><span class="lab"> · Growth Lab</span></a>
          <p class="muted">{me.role}, {me.location}. {me.lookingFor && me.openToWork ? `Open to ${me.lookingFor.toLowerCase()}.` : ''}</p>
        </div>
        <div class="foot-links">
          <a href={me.linkedin}>LinkedIn</a>
          <a href={me.github}>GitHub</a>
          <a href="/contact/">Contact</a>
          <a href="/privacy/">Privacy</a>
        </div>
      </div>
      <div class="wrap foot-small">
        <span>© {year} {me.name}</span>
        <span class="mono">Built with Astro · Hosted on Cloudflare · Measured with GA4</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 8px; background: var(--surface); padding: 8px 12px; border-radius: 8px; z-index: 20; }
  .skip:focus { left: 12px; }
  .top {
    position: sticky; top: 0; z-index: 10;
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 68px; flex-wrap: wrap; padding-block: 10px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font-size: 1.02rem; }
  .brand strong { font-family: var(--display); font-weight: 700; }
  .lab { color: var(--muted); }
  .mark { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: var(--accent); color: var(--accent-ink); }
  nav { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
  nav a:not(.btn) { color: var(--ink); text-decoration: none; font-weight: 500; padding: 8px 12px; border-radius: 999px; }
  nav a:not(.btn):hover { background: var(--accent-soft); }
  nav a[aria-current='page'] { background: var(--accent-soft); color: var(--accent); }
  .nav-cta { padding: 10px 16px; margin-left: 6px; }
  .foot { border-top: 1px solid var(--line); margin-top: 40px; padding-block: 48px 28px; }
  .foot-grid { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .foot-links { display: flex; gap: 20px; flex-wrap: wrap; align-items: flex-start; }
  .foot-links a { color: var(--ink); text-decoration: none; font-weight: 500; }
  .foot-small { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-top: 32px; color: var(--muted); font-size: 0.85rem; }
  .mono { font-family: var(--mono); font-size: 0.75rem; }
  @media (max-width: 640px) {
    .top { position: static; }
    .lab { display: none; }
    .bar { min-height: 0; gap: 6px; padding-block: 10px 6px; }
    nav { width: 100%; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-left: -10px; }
    nav::-webkit-scrollbar { display: none; }
    nav a:not(.btn) { padding: 6px 10px; font-size: 0.95rem; white-space: nowrap; }
    .nav-cta { display: none; }
  }
</style>
